# Everything here is OPTIONAL. PadosiSafe runs with none of it.

# Durable storage on Vercel (otherwise data lives in memory and resets on cold starts).
# Add the "Upstash Redis" integration from the Vercel Marketplace and these are filled in for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV style names also work: KV_REST_API_URL, KV_REST_API_TOKEN)

# Smarter alert triage with an LLM. Without it, a built-in rule-based classifier is used.
# The model only picks a category and urgency and writes a one-line summary.
# "What to do now" advice always comes from the vetted playbooks in lib/playbooks.js.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Local development only
# PORT=3000
# PADOSI_STORE=memory   # keep data in memory instead of data/db.json
